# Convex writes these when you connect the project with npx convex dev.
CONVEX_DEPLOYMENT=
VITE_CONVEX_URL=

# Local values for the S2 smoke test only. Keep credentials in ignored .env/.env.local.
# Apply server values separately with npx convex env set (repeat with --prod for S3).
# Never prefix these values with VITE_.
FAL_KEY=
LLM_BASE_URL=https://fal.run/openrouter/router/openai/v1
LLM_MODEL=openai/gpt-6-luna
# LLM_AUTH is set in Convex as Key <FAL_KEY> after a successful smoke test.
